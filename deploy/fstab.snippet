# GymTracker NAS share: append to /etc/fstab, then
#   sudo mkdir -p /mnt/nas-workouts && sudo systemctl daemon-reload
#
# A systemd automount: nothing mounts at boot (noauto, nofail), so an offline NAS never
# blocks boot or the app. The share mounts on first access and unmounts after 5 idle
# minutes. A space in the path is written \040.
#
# Credentials live in /etc/samba/creds-gymtracker (root, mode 600), never in the repo:
#   username=<NAS user>
#   password=<NAS password>
#   domain=<optional>
//kabane/Media/Gym\040Tracker  /mnt/nas-workouts  cifs  credentials=/etc/samba/creds-gymtracker,uid=1000,gid=1000,file_mode=0644,dir_mode=0755,iocharset=utf8,soft,noauto,nofail,_netdev,x-systemd.automount,x-systemd.idle-timeout=300,x-systemd.mount-timeout=20  0  0
