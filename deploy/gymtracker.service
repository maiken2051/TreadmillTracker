# systemd user service: ~/.config/systemd/user/gymtracker.service (install.sh puts it there).
# Lingering (loginctl enable-linger) starts it at boot, before anyone logs in.
#   journalctl --user-unit gymtracker -f   follow the log
#   systemctl --user stop gymtracker       before running `gymtracker run` by hand
[Unit]
Description=Gym Tracker: treadmill and heart-rate recorder, touchscreen page on :8080
After=network-online.target

[Service]
ExecStart=%h/venv/bin/gymtracker run --quiet -v
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
